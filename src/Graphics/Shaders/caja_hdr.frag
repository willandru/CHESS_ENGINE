#version 330 core


//------------------------------------------------
// INPUT
//------------------------------------------------

in vec3 WorldPosition;

in vec3 Normal;



//------------------------------------------------
// OUTPUT
//------------------------------------------------

out vec4 FragColor;



//------------------------------------------------
// HDRI
//------------------------------------------------

uniform sampler2D hdriMap;



//------------------------------------------------
// PARAMETERS
//------------------------------------------------

uniform float exposure;

uniform float hdriRotation;

uniform float hdriHeight;



//====================================================
// CONSTANTS
//====================================================

const float PI =
    3.14159265359;



//====================================================
// MAIN
//====================================================

void main()
{

    //------------------------------------------------
    // HDRI PROJECTION CENTER
    //------------------------------------------------

    vec3 hdriCenter =
        vec3(
            0.0,
            hdriHeight,
            0.0
        );



    vec3 direction =
        normalize(
            WorldPosition -
            hdriCenter
        );



    //------------------------------------------------
    // ROTATION AROUND HEIGHT AXIS
    //------------------------------------------------

    float angle =
        atan(
            direction.z,
            direction.x
        );


    angle +=
        hdriRotation;


    //----------------------------------------
    // WRAP ROTATION
    //----------------------------------------

    if(angle > PI)
    {
        angle -=
            2.0 * PI;
    }


    if(angle < -PI)
    {
        angle +=
            2.0 * PI;
    }



    //------------------------------------------------
    // EQUIRECTANGULAR UV
    //------------------------------------------------

    float u =
        angle /
        (2.0 * PI)
        + 0.5;



    float v =
        1.0 -
        (
            asin(
                clamp(
                    direction.y,
                    -1.0,
                    1.0
                )
            )
            / PI
            + 0.5
        );



    vec3 color =
        texture(
            hdriMap,
            vec2(
                u,
                v
            )
        ).rgb;



    //------------------------------------------------
    // EXPOSURE
    //------------------------------------------------

    color *=
        exposure;



    //------------------------------------------------
    // OUTPUT
    //------------------------------------------------

    FragColor =
        vec4(
            color,
            1.0
        );

}