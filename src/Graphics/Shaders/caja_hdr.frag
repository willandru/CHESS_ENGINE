// caja_hdr.frag

#version 330 core


//------------------------------------------------
// INPUT
//------------------------------------------------

in vec3 WorldPosition;

in vec3 Normal;



//------------------------------------------------
// OUTPUT
//------------------------------------------------

out vec4 FragColor;



//------------------------------------------------
// HDRI
//------------------------------------------------

uniform sampler2D hdriMap;



//------------------------------------------------
// PARAMETERS
//------------------------------------------------

uniform float exposure;

uniform float hdriRotation;



//====================================================
// CONSTANTS
//====================================================

const float PI =
    3.14159265359;



//====================================================
// MAIN
//====================================================

void main()
{

    //------------------------------------------------
    // DIRECTION FROM ROOM CENTER
    //------------------------------------------------

    vec3 direction =
        normalize(
            WorldPosition
        );



    //------------------------------------------------
    // ROTATION AROUND HEIGHT AXIS
    // (VERTICAL AXIS)
    //------------------------------------------------

    float angle =
        atan(
            direction.z,
            direction.x
        );



    angle +=
        hdriRotation;



    //------------------------------------------------
    // EQUIRECTANGULAR UV
    //------------------------------------------------

    float u =
        angle /
        (2.0 * PI)
        + 0.5;



    float v =
        1.0 -
        (
            asin(
                clamp(
                    direction.y,
                    -1.0,
                    1.0
                )
            )
            / PI
            + 0.5
        );



    vec3 color =
        texture(
            hdriMap,
            vec2(
                u,
                v
            )
        ).rgb;



    //------------------------------------------------
    // EXPOSURE
    //------------------------------------------------

    color *=
        exposure;



    //------------------------------------------------
    // OUTPUT
    //------------------------------------------------

    FragColor =
        vec4(
            color,
            1.0
        );

}